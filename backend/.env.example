# Канонический шаблон переменных окружения.
# Скопируйте в `.env` рядом с этим файлом и заполните реальными значениями.
# Никогда не коммитьте `.env` в репозиторий.

# ============ Приложение ============
APP_NAME=clinical-compass-backend
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ============ Сервер ============
HOST=0.0.0.0
PORT=3001

# ============ База данных (PostgreSQL) ============
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============ Redis / Celery ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============ Безопасность / JWT ============
SECRET_KEY=<replace-with-strong-secret-min-32-chars>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2

# ============ SMS (dev-заглушка) ============
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_SECONDS=60
SMS_MAX_ATTEMPTS=3
SMS_MAX_PER_HOUR=5

# ============ Rate limit входа ============
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_WINDOW_SECONDS=900

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,exp://localhost:8081,http://10.0.2.2:3001

# ============ Уведомления ============
NOTIFICATION_PROVIDER=log
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============ ГРЛС / лекарства ============
GRLS_ENABLED=false
AVIANDR_BASE_URL=https://aviandr.ru

# ============ Тесты ============
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
TEST_REDIS_URL=redis://localhost:6379/15
SKIP_DB_TESTS=0

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FORMAT=json
WORKERS=1

# ============ ?????????? (??? / ?????????) ============
MIS_BASE_URL=
MIS_API_TOKEN=
EMERGENCY_BASE_URL=
EMERGENCY_API_TOKEN=
