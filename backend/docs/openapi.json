  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "minLength": 1,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest"
      },
      "EnvelopeResponse": {
        "properties": {
          "data": {
            "title": "Data",
            "description": "Полезная нагрузка ответа"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "description": "Метаданные запроса (request_id, timestamp)"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Ошибка, если есть"
          }
        },
        "type": "object",
        "title": "EnvelopeResponse",
        "description": "Стандартный конверт ответа API."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteCodeCreateRequest": {
        "properties": {
          "expires_in_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Expires In Days",
            "default": 30
          },
          "is_multi_use": {
            "type": "boolean",
            "title": "Is Multi Use",
            "default": false
          },
          "max_uses": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Uses"
          }
        },
        "type": "object",
        "title": "InviteCodeCreateRequest",
        "description": "Врач задаёт TTL кода; опционально — мультииспользование."
      },
      "InviteVerifyRequest": {
        "properties": {
          "code": {
