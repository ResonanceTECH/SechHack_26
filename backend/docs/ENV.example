# Переменные окружения (шаблон)

Скопировать в `.env` и заполнить реальными значениями.  
**Никогда не коммитить `.env` в репозиторий.**

```ini
# ============ Приложение ============
APP_NAME=clinical-compass-backend
APP_VERSION=1.0.0-mvp
DEBUG=true
ENVIRONMENT=development

# ============ Сервер ============
# Порт 3001 унифицирован с клиентами: mobile_dev (Expo) и frontend_dev ждут http://localhost:3001
HOST=0.0.0.0
PORT=3001
WORKERS=1

# ============ База данных (PostgreSQL) ============
# Одна база sechhack, логическое разделение concept01/concept02
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sechhack
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============ Redis / Celery ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============ Безопасность / JWT ============
SECRET_KEY=сменить-на-надёжный-секретный-ключ-min-32-символа
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2

# ============ CORS ============
# Веб-кабинет (React Vite) и React Native + Expo
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,exp://localhost:8081,http://10.0.2.2:3001

# ============ Уведомления ============
# Push / SMS / email — интеграция откладывается, пока заглушки (логирование)
NOTIFICATION_PROVIDER=log
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============ ГРЛС / лекарства ============
# Данные по лекарствам отдаём согласно экранам Figma (полная инфа врачу / упрощённая пациенту)
# Интеграция с api.pharm-portal.ru отложена (требует auth key)
GRLS_ENABLED=false
AVIANDR_BASE_URL=https://aviandr.ru

# ============ Тесты ============
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sechhack_test
TEST_REDIS_URL=redis://localhost:6379/15
SKIP_DB_TESTS=0

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FORMAT=json