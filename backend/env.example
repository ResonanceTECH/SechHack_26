# Python/FastAPI окружение — скопировать в `.env` рядом с этим файлом.
# НЕ путать с `.env.example` (шаблон для Node.js-заглушки в `src/`):
# оба шаблона совместимы — конфиг сам достроит драйвер asyncpg из DATABASE_URL.

# ============ Приложение ============
APP_NAME=clinical-compass-backend
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ============ Сервер ============
# Порт 3001 унифицирован с клиентами: mobile_dev (Expo) и frontend_dev ждут http://localhost:3001
HOST=0.0.0.0
PORT=3001

# ============ База данных (PostgreSQL) ============
# Одна база sechhack; PostgreSQL-схема rx (рецептурный контур) подключится на этапе 7
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sechhack
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============ Redis / Celery (включается на этапах 6/8) ============
REDIS_URL=redis://localhost:6379/0

# ============ Безопасность / JWT ============
# Минимум 32 символа! В проде — только через переменные окружения, не в репозитории
SECRET_KEY=сменить-на-надёжный-секретный-ключ-min-32-символа
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ SMS (dev-заглушка: код пишется в лог сервера) ============
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_SECONDS=60
SMS_MAX_ATTEMPTS=3
SMS_MAX_PER_HOUR=5

# ============ Rate limit входа (брутфорс) ============
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_WINDOW_SECONDS=900

# ============ CORS ============
# Веб-кабинет (React Vite) и React Native + Expo
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,exp://localhost:8081,http://10.0.2.2:3001

# ============ Логирование ============
LOG_LEVEL=INFO

# ============ Тесты ============
# 1 = пропускать тесты, требующие PostgreSQL (см. TESTS.md §2)
SKIP_DB_TESTS=0
