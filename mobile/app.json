{
  "expo": {
    "name": "Клинический компас",
    "slug": "klinicheskiy-kompas",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FC"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Клинический компас",
        "NSCameraUsageDescription": "Камера нужна, чтобы отсканировать QR-код приглашения от врача."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F8FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Клинический компас"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы отсканировать QR-код приглашения от врача.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ce2f46c-c154-42aa-adc3-6db530017e14"
      }
    }
  }
}
